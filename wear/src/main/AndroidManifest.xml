<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alphahealth.monitor.wear">

    <!-- ── Biometric sensor permissions ── -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- ── Declares this is a Wear OS app ── -->
    <!-- required="false" allows debug sideloading on phones; on production    -->
    <!-- Play Store it still routes to Wear OS devices automatically.          -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="NeuralPulse"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeuralPulse.Wear">

        <!-- ── Required Wear OS library declaration ── -->
        <!-- required="false" ensures the APK installs on Wear OS emulators   -->
        <!-- and non-Google-certified watches. At runtime, the app checks      -->
        <!-- hardware availability before calling wearable APIs.               -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- ── Main watch face dashboard ── -->
        <activity
            android:name=".presentation.WatchDashboardActivity"
            android:exported="true"
            android:label="NeuralPulse"
            android:theme="@style/Theme.NeuralPulse.Wear"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Tile Service (Wear OS watch tile — any OEM) ── -->
        <service
            android:name=".surfaces.AlphaHealthTileService"
            android:exported="true"
            android:label="NeuralPulse Recovery"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@android:drawable/sym_def_app_icon" />
        </service>

        <!-- ── Complication data source (any Wear OS watch face) ── -->
        <service
            android:name=".surfaces.EnergyScoreComplication"
            android:exported="true"
            android:label="NeuralPulse Energy Score"
            android:icon="@android:drawable/sym_def_app_icon"
            android:permission="android.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

    </application>
</manifest>
